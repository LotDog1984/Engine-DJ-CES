# Keep the repo from growing with runtime/by-products after the initial push.
# Everything in stems-lab is deliberately included on day one.

# Runtime artifacts the service and shim create - never source.
*.log
switch-log.txt
engine/engine.port
stems-lab/engine/engine.port
stems-lab/engine/cache
stems-lab/engine/sessions
stems-lab/switch-app/selftest-report.txt

# Python runtime and build artifacts.
__pycache__
*.pyc
*.pyo
.venv
.ffmpeg

# OS metadata.
.DS_Store
Thumbs.db

# The venv's own ignore of itself.
venv
.env

# Downloaded at first run by the switch app's "Set up Custom Engine" button, or produced by
# the test runs. Rebuildable from requirements.txt / the model host, so never committed:
#   models/          the 913 MB vocal model (audio-separator fetches it)
#   bin/             the stock stems-processor.exe reference copy (~400 MB)
#   engine/references, engine/stock   separation output kept for comparison
stems-lab/models/
bin/
stems-lab/engine/references/
stems-lab/engine/stock/

# uv is fetched from GitHub releases beside the app when it is missing, then unpacked.
uv.exe
_uv_extract/
_uv_download.zip

# Logs written by a headless setup run.
setup-log*.txt

# Scratch directory tests/test-engine-switch.ps1 builds and leaves behind.
stems-lab/tests/sandbox/

# The delegation and handle suites build sandboxes of their own and keep them for inspection.
stems-lab/tests/shim-run/

# Reverse-engineering scratch kept on disk on purpose (PE/ONNX scanners, string dumpers,
# the disassembly helper) plus the desktop app's project marker. Useful locally, no reason
# to ship it, so it is untracked here rather than deleted.
.freebuff/
